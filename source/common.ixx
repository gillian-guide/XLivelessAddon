// SPDX-License-Identifier: GPL-3.0-or-later
//
// xla.common - the load-time context, the FusionFix event tiers, the trace log
// and the helpers every feature shares.
//
// The `Event<Args...>` template, the tier names and the `Log`/`Game` shapes follow
// GTAIV.EFLC.FusionFix's common.ixx (GPL-3.0, ThirteenAG and contributors). The
// install context here adds the image, the recognised game build and the loaded
// INI values, so a feature reads them through `Game::Get()` and never takes them
// as parameters.

module;

#include <common.hxx>

export module common;

export namespace xla
{
    // The product identity, generated by CMake. Kept in the exported module so a
    // feature can log it without reaching into the generated header.
    inline constexpr std::string_view kProductName = XLA_PRODUCT_NAME;
    inline constexpr std::string_view kVersion = XLA_VERSION_TEXT;
    inline constexpr std::string_view kGitSha = XLA_GIT_SHA_TEXT;

    // The builds the add-on recognises. The numeric value is the original's
    // compact build id (the classification dword's table value), not the game's
    // four-part version; `unknown` installs nothing.
    enum class GameBuild : std::uint32_t
    {
        unknown = 0,
        v1000 = 1000,
        v1010 = 1010,
        v1020 = 1020,
        v1030 = 1030,
        v1040 = 1040,
        v1050 = 1050,
        v1060 = 1060,
        v1070 = 1070,
        v1080 = 1080,
        v1100 = 1100,
        v1110 = 1110,
        v1120 = 1120,
        v1130 = 1130,
    };

    [[nodiscard]] inline std::string BuildLabel(GameBuild build)
    {
        return build == GameBuild::unknown
                   ? std::string{"unknown"}
                   : std::to_string(static_cast<std::uint32_t>(build));
    }

    [[nodiscard]] inline constexpr bool IsBuild(GameBuild build,
                                                std::initializer_list<GameBuild> set) noexcept
    {
        for (const GameBuild candidate : set)
        {
            if (candidate == build)
            {
                return true;
            }
        }
        return false;
    }

    [[nodiscard]] inline constexpr bool IsEflc(GameBuild build) noexcept
    {
        return IsBuild(build, {GameBuild::v1100, GameBuild::v1110, GameBuild::v1120,
                               GameBuild::v1130});
    }

    // The original mod's build id for a recognised build: the bit index the recovered
    // option masks use (bit i == ordinal i, the original's classify_game_build switch,
    // which this add-on's own classification predates). A recovered mask is data and
    // is kept verbatim, so this is the one mapping between the two vocabularies:
    // 1.0.0.0 = 1, 1.0.4.0 = 5, 1.0.0.4 = 6, 1.0.6.0 = 7, 1.0.7.0 = 8, 1.0.8.0 = 9,
    // 1.1.0.0 = 10, 1.1.1.0 = 11, 1.1.2.0 = 12, 1.1.3.0 = 13. 1.0.1.0/1.0.2.0/1.0.3.0
    // are builds this add-on recognises and the original mod does not, so they have no
    // id and no recovered mask can cover them (the original ASI patched nothing on an
    // image it could not classify).
    [[nodiscard]] inline constexpr std::optional<std::uint32_t> OriginalBuildId(
        GameBuild build) noexcept
    {
        switch (build)
        {
        case GameBuild::v1000:
            return 1u;
        case GameBuild::v1040:
            return 5u;
        case GameBuild::v1050:
            return 6u;
        case GameBuild::v1060:
            return 7u;
        case GameBuild::v1070:
            return 8u;
        case GameBuild::v1080:
            return 9u;
        case GameBuild::v1100:
            return 10u;
        case GameBuild::v1110:
            return 11u;
        case GameBuild::v1120:
            return 12u;
        case GameBuild::v1130:
            return 13u;
        default:
            return std::nullopt;
        }
    }

    // Whether a build's original id is a set bit of a recovered mask.
    [[nodiscard]] inline constexpr bool BuildInMask(GameBuild build,
                                                    std::uint32_t mask) noexcept
    {
        const std::optional<std::uint32_t> id = OriginalBuildId(build);
        return id.has_value() && *id < 32u && (mask & (1u << *id)) != 0u;
    }

    // A mapped image: the load address and OptionalHeader.SizeOfImage. The game
    // module, a test buffer and a parity dump's private copy are all viewed the
    // same way.
    struct Image
    {
        std::byte* base{};
        std::size_t size{};

        [[nodiscard]] constexpr bool empty() const noexcept
        {
            return base == nullptr || size == 0;
        }

        [[nodiscard]] constexpr std::span<std::byte> bytes() const noexcept
        {
            return {base, size};
        }

        [[nodiscard]] bool contains(const void* address, std::size_t length) const noexcept
        {
            const auto begin = reinterpret_cast<std::uintptr_t>(base);
            const auto site = reinterpret_cast<std::uintptr_t>(address);
            if (begin == 0 || site < begin)
            {
                return false;
            }
            const auto offset = site - begin;
            return length <= size && offset <= size - length;
        }
    };

    // True when [address, address + length) lies inside a loaded module's image (the
    // loader's SizeOfImage range). The VRAM arm's copied code answers its 08:21 crash
    // with it: a pointer the patterns resolved wrongly was called and the target was a
    // private, unmapped page, so anything not inside a module is treated as "not a
    // code object" and never called.
    inline bool IsModuleRange(const void* address, std::size_t length = 1) noexcept
    {
        const auto begin = reinterpret_cast<std::uintptr_t>(address);
        if (begin == 0 || length == 0)
        {
            return false;
        }
        const auto end = begin + length;

        std::array<HMODULE, 256> modules{};
        DWORD needed = 0;
        if (!::EnumProcessModules(::GetCurrentProcess(), modules.data(),
                                  static_cast<DWORD>(modules.size() * sizeof(HMODULE)),
                                  &needed))
        {
            return false;
        }
        const std::size_t count =
            std::min<std::size_t>(modules.size(), needed / sizeof(HMODULE));
        for (std::size_t index = 0; index < count; ++index)
        {
            MODULEINFO info{};
            if (!::GetModuleInformation(::GetCurrentProcess(), modules[index], &info,
                                        sizeof(info)))
            {
                continue;
            }
            const auto base = reinterpret_cast<std::uintptr_t>(info.lpBaseOfDll);
            if (base != 0 && begin >= base && end <= base + info.SizeOfImage)
            {
                return true;
            }
        }
        return false;
    }

    // The FusionFix tiers. This add-on installs synchronously from `onInit`; the
    // rest exist so a feature written for FusionFix keeps its shape and so a
    // later port does not have to invent a tier.
    class FusionFix
    {
    public:
        // FusionFix's Event, unchanged: a mutex-guarded std::function handler
        // list. `operator+=` returns the token that removes the handler;
        // executeAll runs a snapshot in subscription order; executeAllAsync runs
        // each handler on its own thread.
        template <typename... Args>
        class Event : public std::function<void(Args...)>
        {
        public:
            using std::function<void(Args...)>::function;

        private:
            struct Handler
            {
                std::function<void(Args...)> callback;
                std::atomic<bool> active{true};

                explicit Handler(std::function<void(Args...)>&& fn) : callback(std::move(fn)) {}
            };

            mutable std::mutex handlersMutex;
            std::list<std::shared_ptr<Handler>> handlers;

            auto snapshot() const
            {
                std::lock_guard lock(handlersMutex);
                return std::vector<std::shared_ptr<Handler>>(handlers.begin(), handlers.end());
            }

        public:
            auto operator+=(std::function<void(Args...)>&& callback) -> std::function<void()>
            {
                auto handler = std::make_shared<Handler>(std::move(callback));
                {
                    std::lock_guard lock(handlersMutex);
                    handlers.push_back(handler);
                }
                return [this, handler]()
                {
                    std::lock_guard lock(handlersMutex);
                    handler->active = false;
                    handlers.remove(handler);
                };
            }

            void executeAll(Args... args) const
            {
                for (const auto& handler : snapshot())
                {
                    if (handler->active)
                    {
                        handler->callback(args...);
                    }
                }
            }

            std::vector<std::future<void>> executeAllAsync(Args... args) const
            {
                std::vector<std::future<void>> futures;
                for (const auto& handler : snapshot())
                {
                    futures.emplace_back(std::async(
                        std::launch::async,
                        [handler, values = std::tuple<Args...>(args...)]() mutable
                        {
                            if (handler->active)
                            {
                                std::apply(handler->callback, values);
                            }
                        }));
                }
                return futures;
            }
        };

        static Event<>& onInitEvent()
        {
            static Event<> InitEvent;
            return InitEvent;
        }
        static Event<>& onInitEventAsync()
        {
            static Event<> InitEventAsync;
            return InitEventAsync;
        }
        static Event<>& onShutdownEvent()
        {
            static Event<> ShutdownEvent;
            return ShutdownEvent;
        }
        static Event<>& onGameInitEvent()
        {
            static Event<> GameInitEvent;
            return GameInitEvent;
        }
        static Event<>& onGameProcessEvent()
        {
            static Event<> GameProcessEvent;
            return GameProcessEvent;
        }
        static Event<>& onMenuDrawingEvent()
        {
            static Event<> MenuDrawingEvent;
            return MenuDrawingEvent;
        }
        static Event<>& onMenuEnterEvent()
        {
            static Event<> MenuEnterEvent;
            return MenuEnterEvent;
        }
        static Event<>& onMenuExitEvent()
        {
            static Event<> MenuExitEvent;
            return MenuExitEvent;
        }
        static Event<bool>& onActivateApp()
        {
            static Event<bool> ActivateApp;
            return ActivateApp;
        }
        static Event<>& onBeforeReset()
        {
            static Event<> BeforeReset;
            return BeforeReset;
        }
        static Event<>& onEndScene()
        {
            static Event<> EndScene;
            return EndScene;
        }
        static Event<>& onReadGameConfig()
        {
            static Event<> ReadGameConfig;
            return ReadGameConfig;
        }
    };

    // One line-buffered trace file per module, opened once by the startup driver.
    // A feature logs through Log::Print at the point of the decision it is tracing;
    // Log::Trace is the same line, compiled in only for the Trace configuration.
    class Log
    {
    public:
        static bool Open(const std::filesystem::path& path)
        {
            std::lock_guard lock(Mutex());
            auto& stream = Stream();
            if (stream.is_open())
            {
                stream.close();
            }
            FilePath() = path;
            stream.open(path, std::ios::out | std::ios::trunc | std::ios::binary);
            return stream.is_open();
        }

        static void Close()
        {
            std::lock_guard lock(Mutex());
            if (Stream().is_open())
            {
                Stream().close();
            }
        }

        static bool IsOpen()
        {
            std::lock_guard lock(Mutex());
            return Stream().is_open();
        }

        static const std::filesystem::path& Path() { return FilePath(); }

        static void Line(std::string_view text)
        {
            std::lock_guard lock(Mutex());
            auto& stream = Stream();
            if (!stream.is_open())
            {
                return;
            }
            stream << text << "\r\n";
            stream.flush();
        }

        template <typename... Args>
        static void Print(std::format_string<Args...> text, Args&&... args)
        {
            Line(std::format(text, std::forward<Args>(args)...));
        }

        template <typename... Args>
        static void Trace(std::format_string<Args...> text, Args&&... args)
        {
#ifdef XLA_TRACE
            Line(std::format(text, std::forward<Args>(args)...));
#else
            (void)text;
            ((void)args, ...);
#endif
        }

    private:
        static std::mutex& Mutex()
        {
            static std::mutex mutex;
            return mutex;
        }
        static std::ofstream& Stream()
        {
            static std::ofstream stream;
            return stream;
        }
        static std::filesystem::path& FilePath()
        {
            static std::filesystem::path path;
            return path;
        }
    };

    // The full path of a loaded module, or empty if the name cannot be read.
    inline std::wstring ModuleFileName(HMODULE module)
    {
        static constexpr auto InitialBufferSize = MAX_PATH;
        static constexpr auto MaxIterations = 7;

        std::wstring name;
        auto bufferSize = InitialBufferSize;
        for (size_t iteration = 0; iteration < MaxIterations; ++iteration)
        {
            name.resize(bufferSize);
            const auto written = GetModuleFileNameW(module, name.data(), bufferSize);
            if (written < name.size())
            {
                name.resize(written);
                return name;
            }
            bufferSize *= 2;
        }
        return {};
    }

    inline HMODULE GetThisModuleHandle()
    {
        HMODULE module{};
        GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                           reinterpret_cast<LPCWSTR>(&GetThisModuleHandle), &module);
        return module;
    }

    // ANSI conversion with the same result as the GetModuleFileNameA form: the
    // path helpers below hand out byte strings the Win32 API can take back.
    inline std::string Narrow(std::wstring_view text)
    {
        if (text.empty())
        {
            return {};
        }
        const auto length = WideCharToMultiByte(CP_ACP, 0, text.data(),
                                                static_cast<int>(text.size()), nullptr, 0,
                                                nullptr, nullptr);
        std::string result(length, '\0');
        WideCharToMultiByte(CP_ACP, 0, text.data(), static_cast<int>(text.size()),
                            result.data(), length, nullptr, nullptr);
        return result;
    }

    inline std::wstring Widen(std::string_view text)
    {
        return std::wstring(text.begin(), text.end());
    }

    inline bool iequals(std::string_view first, std::string_view second)
    {
        if (first.size() != second.size())
        {
            return false;
        }
        return std::equal(first.begin(), first.end(), second.begin(), second.end(),
                          [](char a, char b) { return ::tolower(a) == ::tolower(b); });
    }

    inline bool iequals(std::wstring_view first, std::wstring_view second)
    {
        if (first.size() != second.size())
        {
            return false;
        }
        return std::equal(first.begin(), first.end(), second.begin(), second.end(),
                          [](wchar_t a, wchar_t b) { return ::towlower(a) == ::towlower(b); });
    }

    // The add-on's flag grammar, unchanged from the original's `atoi(value) != 0`:
    // skip leading white space, accept one sign, consume the decimal prefix; any
    // non-zero result enables, and an empty or non-numeric value disables (it does
    // not fall back to the default).
    [[nodiscard]] constexpr bool ParseFlag(std::string_view text) noexcept
    {
        std::size_t index = 0;
        while (index < text.size() &&
               (text[index] == ' ' || text[index] == '\t' || text[index] == '\n' ||
                text[index] == '\v' || text[index] == '\f' || text[index] == '\r'))
        {
            ++index;
        }

        bool negative = false;
        if (index < text.size() && (text[index] == '+' || text[index] == '-'))
        {
            negative = text[index] == '-';
            ++index;
        }

        long long value = 0;
        for (; index < text.size() && text[index] >= '0' && text[index] <= '9'; ++index)
        {
            const int digit = text[index] - '0';
            if (value > (LLONG_MAX - digit) / 10)
            {
                value = LLONG_MAX;
                break;
            }
            value = value * 10 + digit;
        }
        return negative ? -value != 0 : value != 0;
    }

    // The x86 opcodes the recovered tables store. Naming them keeps a byte in a
    // table read as an instruction instead of a number; each value is the
    // instruction's first byte, with the ModRM forms named next to the opcode
    // they belong to.
    enum class Opcode : std::uint8_t
    {
        kNop = 0x90,         // nop
        kRet = 0xC3,         // ret
        kRetImm16 = 0xC2,    // ret imm16
        kCallRel32 = 0xE8,   // call rel32
        kJmpRel32 = 0xE9,    // jmp rel32
        kJmpRel8 = 0xEB,     // jmp rel8
        kMovAlImm8 = 0xB0,   // mov al, imm8
        kMovMoffsEax = 0xA3, // mov moffs32, eax
        kMovEaxImm32 = 0xB8, // mov eax, imm32
        kMovR32Rm32 = 0x8B,  // mov r32, r/m32
        kMovRm32R32 = 0x89,  // mov r/m32, r32
        kXorEaxEax = 0x33,   // first byte of `xor eax,eax`
        kModRmEaxEax = 0xC0, // its ModRM
    };

    [[nodiscard]] constexpr std::uint8_t Byte(Opcode opcode) noexcept
    {
        return static_cast<std::uint8_t>(opcode);
    }

    // `EB <rel8>` as one little-endian word (the recovered rows store rel8 pairs
    // this way; naming the displacement makes the packed value readable).
    [[nodiscard]] constexpr std::uint16_t JmpShort(std::int8_t displacement) noexcept
    {
        return static_cast<std::uint16_t>(
            Byte(Opcode::kJmpRel8) |
            (static_cast<std::uint16_t>(static_cast<std::uint8_t>(displacement)) << 8));
    }

    // The little-endian dword of a four-byte instruction window, derived from the
    // byte catalogue instead of re-spelling the number.
    [[nodiscard]] constexpr std::uint32_t Dword(std::span<const std::uint8_t, 4> bytes) noexcept
    {
        return static_cast<std::uint32_t>(bytes[0]) |
               (static_cast<std::uint32_t>(bytes[1]) << 8) |
               (static_cast<std::uint32_t>(bytes[2]) << 16) |
               (static_cast<std::uint32_t>(bytes[3]) << 24);
    }

    // The little-endian word of a two-byte instruction window.
    [[nodiscard]] constexpr std::uint16_t Word(std::span<const std::uint8_t, 2> bytes) noexcept
    {
        return static_cast<std::uint16_t>(static_cast<std::uint16_t>(bytes[0]) |
                                          (static_cast<std::uint16_t>(bytes[1]) << 8));
    }

    // Recovered instruction windows shared by the patch tables. Each is the exact
    // byte sequence the original writes; the names say what it executes.
    namespace ops
    {
        inline constexpr std::uint8_t kJmpRel8[]{Byte(Opcode::kJmpRel8)};
        inline constexpr std::uint8_t kJmpRel32[]{Byte(Opcode::kJmpRel32)};
        inline constexpr std::uint8_t kRet[]{Byte(Opcode::kRet)};
        inline constexpr std::uint8_t kXorEaxEax[]{Byte(Opcode::kXorEaxEax),
                                                   Byte(Opcode::kModRmEaxEax)};
        inline constexpr std::uint8_t kNopMovMoffsEax[]{Byte(Opcode::kNop),
                                                        Byte(Opcode::kMovMoffsEax)};
        inline constexpr std::uint8_t kNop2[]{Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop3[]{Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop4[]{Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop6[]{Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop8[]{Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop),
                                              Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop11[]{
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop),
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop),
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kNop14[]{
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop),
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop),
            Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop), Byte(Opcode::kNop),
            Byte(Opcode::kNop), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kXorEaxRetNop[]{Byte(Opcode::kXorEaxEax),
                                                      Byte(Opcode::kModRmEaxEax),
                                                      Byte(Opcode::kRet), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kMovAl1RetNop[]{
            Byte(Opcode::kMovAlImm8), 0x01, // mov al, 1 (imm8)
            Byte(Opcode::kRet), Byte(Opcode::kNop)};
        inline constexpr std::uint8_t kRet8[]{
            Byte(Opcode::kRetImm16), 0x08, 0x00}; // ret 8 (imm16, little-endian)
    } // namespace ops

    // FusionFix's byte helpers.
    template <typename T>
    std::array<std::uint8_t, sizeof(T)> to_bytes(const T& object)
    {
        static_assert(std::is_trivially_copyable_v<T>, "not a TriviallyCopyable type");
        std::array<std::uint8_t, sizeof(T)> bytes;
        const auto* begin = reinterpret_cast<const std::uint8_t*>(std::addressof(object));
        std::copy(begin, begin + sizeof(T), bytes.begin());
        return bytes;
    }

    template <typename T>
    T& from_bytes(const std::array<std::uint8_t, sizeof(T)>& bytes, T& object)
    {
        static_assert(std::is_trivially_copyable_v<T>, "not a TriviallyCopyable type");
        auto* begin = reinterpret_cast<std::uint8_t*>(std::addressof(object));
        std::copy(bytes.begin(), bytes.end(), begin);
        return object;
    }

    template <class T, class T1>
    T from_bytes(const T1& bytes)
    {
        static_assert(std::is_trivially_copyable_v<T>, "not a TriviallyCopyable type");
        T object;
        auto* begin = reinterpret_cast<std::uint8_t*>(std::addressof(object));
        std::copy(std::begin(bytes), std::end(bytes) - (sizeof(T1) - sizeof(T)), begin);
        return object;
    }

    // The process-wide install context. The startup driver fills it once; every
    // feature reads it through Get(), so no feature takes a parameter list or
    // depends on another feature's publication order.
    class Game
    {
    public:
        using Version = std::array<std::uint16_t, 4>;

        static Game& Get()
        {
            static Game game;
            return game;
        }

        // Resolves the module/game directories, the image and its file version.
        // Only the first call does work; the probe retry re-enters the pass and
        // must not reset what the first pass wrote.
        void Initialise(HMODULE moduleHandle)
        {
            if (initialized)
            {
                return;
            }

            module = moduleHandle != nullptr ? moduleHandle : GetThisModuleHandle();
            modulePath = ModuleFileName(this->module);
            executablePath = ModuleFileName(nullptr);

            const auto image = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
            const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(image);
            if (dos != nullptr && dos->e_magic == IMAGE_DOS_SIGNATURE)
            {
                const auto* nt =
                    reinterpret_cast<const IMAGE_NT_HEADERS*>(image + dos->e_lfanew);
                if (nt->Signature == IMAGE_NT_SIGNATURE)
                {
                    imageBase = image;
                    imageSize = nt->OptionalHeader.SizeOfImage;
                }
            }

            fileVersion = ReadFileVersion(executablePath);
            initialized = true;
        }

        bool Initialised() const { return initialized; }

        HMODULE Module() const { return module; }
        const std::filesystem::path& ModulePath() const { return modulePath; }
        std::filesystem::path ModuleDirectory() const { return modulePath.parent_path(); }
        std::string ModuleName() const { return modulePath.filename().string(); }

        const std::filesystem::path& ExecutablePath() const { return executablePath; }
        std::filesystem::path ExecutableDirectory() const
        {
            return executablePath.parent_path();
        }

        uintptr_t ImageBase() const { return imageBase; }
        size_t ImageSize() const { return imageSize; }
        Image View() const
        {
            return {reinterpret_cast<std::byte*>(imageBase), imageSize};
        }
        bool Contains(const void* address, size_t length) const
        {
            return View().contains(address, length);
        }

        const Version& FileVersion() const { return fileVersion; }
        std::string FileVersionString() const
        {
            return std::format("{}.{}.{}.{}", fileVersion[0], fileVersion[1], fileVersion[2],
                               fileVersion[3]);
        }

        // The recognised build. `unknown` until the build step has read it.
        GameBuild Build() const { return build; }
        void SetBuild(GameBuild value) { build = value; }

        // The two files a module owns sit next to it and share its stem.
        std::filesystem::path IniPath() const { return WithExtension(L".ini"); }
        std::filesystem::path LogPath() const { return WithExtension(L".log"); }

        // INI values. config.ixx populates these once, including every default, so
        // a feature can read a present key and an absent one the same way.
        void SetOption(std::string key, std::string value)
        {
            options.insert_or_assign(std::move(key), std::move(value));
        }

        const std::string& OptionString(std::string_view key) const
        {
            static const std::string empty;
            const auto found = options.find(key);
            return found == options.end() ? empty : found->second;
        }

        bool Option(std::string_view key) const { return ParseFlag(OptionString(key)); }

        const std::map<std::string, std::string, std::less<>>& Options() const
        {
            return options;
        }

        // The pass-level stop flag and exit code. A step that cannot continue asks
        // for a stop; the driver checks it between tiers and the steps that follow
        // a stopping one check it themselves.
        bool Stopped() const { return stop; }
        void RequestStop(int code)
        {
            stop = true;
            exitCode = code;
        }
        void ResetPass()
        {
            stop = false;
            exitCode = 0;
        }
        int ExitCode() const { return exitCode; }

    private:
        std::filesystem::path WithExtension(std::wstring_view extension) const
        {
            auto path = modulePath;
            path.replace_extension(extension);
            return path;
        }

        static Version ReadFileVersion(const std::filesystem::path& path)
        {
            DWORD ignored{};
            const DWORD size = GetFileVersionInfoSizeW(path.c_str(), &ignored);
            if (size == 0)
            {
                return {};
            }

            std::vector<std::byte> block(size);
            if (!GetFileVersionInfoW(path.c_str(), 0, size, block.data()))
            {
                return {};
            }

            VS_FIXEDFILEINFO* info{};
            UINT length{};
            if (!VerQueryValueW(block.data(), L"\\", reinterpret_cast<void**>(&info), &length) ||
                info == nullptr)
            {
                return {};
            }

            return {HIWORD(info->dwFileVersionMS), LOWORD(info->dwFileVersionMS),
                    HIWORD(info->dwFileVersionLS), LOWORD(info->dwFileVersionLS)};
        }

        HMODULE module{};
        std::filesystem::path modulePath;
        std::filesystem::path executablePath;
        uintptr_t imageBase{};
        size_t imageSize{};
        Version fileVersion{};
        GameBuild build{GameBuild::unknown};
        std::map<std::string, std::string, std::less<>> options;
        bool stop{};
        int exitCode{};
        bool initialized{};
    };
} // namespace xla
