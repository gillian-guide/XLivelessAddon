// XLivelessAddon PE version resource. CMake configures this template so the
// resource always matches the tag/commit that was built.

#include <winver.h>

#define XLA_FILE_VERSION @XLA_VERSION_MAJOR@,@XLA_VERSION_MINOR@,@XLA_VERSION_PATCH@,0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XLA_FILE_VERSION
 PRODUCTVERSION XLA_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenZDecomp"
            VALUE "FileDescription", "XLivelessAddon for GTA IV / EFLC"
            VALUE "FileVersion", "@XLA_VERSION_STRING@"
            VALUE "InternalName", "XLivelessAddon"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "XLivelessAddon.asi"
            VALUE "ProductName", "XLivelessAddon"
            VALUE "ProductVersion", "@XLA_VERSION_STRING@"
            VALUE "Comments", "FusionFix-style reimplementation. Git @XLA_GIT_SHA@."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
